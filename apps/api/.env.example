PORT=3001
NODE_ENV=development

# Local dev points at docker-compose's Postgres on port 5432.
# Prod (Railway) injects the real DATABASE_URL.
DATABASE_URL=postgres://moodboard:moodboard@localhost:5432/moodboard

# Phase 4b — better-auth
# AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3001

# Phase 5 — Anthropic Claude (required for /api/boards/:id/analyze)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Phase 12 — Notion integration. Set up at
# https://www.notion.so/profile/integrations  →  New integration (Public).
# Capabilities: Read content + Read user information.
#
# IMPORTANT: the redirect URI points at the FRONTEND origin (5173) not the
# API origin (3001). In dev, Vite proxies /api/* to the API; in prod the
# frontend + API are same-origin. This keeps the OAuth state cookie on a
# single host and the better-auth session cookie travels with the popup.
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_REDIRECT_URI=http://localhost:5173/api/connections/notion/callback

# Phase 13 — Google Drive integration. Set up via Google Cloud Console:
# enable Drive API + Sheets API + Slides API, OAuth consent screen
# (External), credentials type Web application with the redirect below.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/connections/drive/callback

# Phase 15 — Spotify integration. Create an app at
# https://developer.spotify.com/dashboard. Scopes are requested at auth time
# (playlist-read-private, playlist-read-collaborative, user-read-email).
# Spotify requires HTTPS redirect URIs OR the http://127.0.0.1 loopback — the
# simplest cross-provider setup is local HTTPS via mkcert (https://127.0.0.1:5173).
# Audio features come from ReccoBeats (free, no key) since Spotify retired its
# audio-features endpoint for apps created after 2024-11-27.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=https://127.0.0.1:5173/api/connections/spotify/callback

# Server-side AES-256-GCM key for encrypting OAuth tokens at rest. Must be
# exactly 64 hex characters (32 bytes). Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# CONNECTION_TOKEN_KEY=

# Origin of the web app that receives postMessage handshakes from the OAuth
# popup callback. Used as the `targetOrigin` arg to window.opener.postMessage —
# must be exact, not '*', so the message can't be received by an attacker
# window holding a reference to our popup.
WEB_ORIGIN=http://localhost:5173

# Phase 16 — Video import (YouTube / TikTok / Instagram / X / Vimeo). Requires
# two system binaries on PATH (declared in nixpacks.toml for Railway):
#   yt-dlp   — brew install yt-dlp   (pulls metadata + thumbnail; downloads the
#              clip for non-YouTube deep analysis)
#   ffmpeg   — brew install ffmpeg   (yt-dlp's post-processor)
#
# Deep video analysis (the "Senior Video Editor" agent — hooks, transitions,
# pacing, sound, dialogue) runs on Google Gemini, which natively understands
# video. OPTIONAL: without the key, clips still import (thumbnail + title +
# channel) and every other agent works; only the video-editor agent needs it.
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Phase 18 — Shareable moodboards (server-rendered PDF).
# The PDF endpoint launches headless Chromium (Playwright) and navigates
# to ${PUBLIC_APP_URL}/share/<token>?print=1 to render the public viewer
# page. In dev this is the Vite origin — `https://` when local mkcert
# certs are in place (the usual setup; see apps/web/vite.config.ts),
# `http://` if MOODBOARD_HTTPS=0. In prod set it to the deployed web
# origin. Playwright is configured to ignore HTTPS errors so the
# mkcert root CA doesn't need to be visible to its bundled Chromium.
PUBLIC_APP_URL=https://localhost:5173
